# Dependencies
node_modules/

# Build output
dist/
.vite/

# Local environment files
.env
.env.*
!.env.example

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor and OS files
.DS_Store
Thumbs.db
.idea/
.vscode/

# Codex/browser verification artifacts
.codex-screens/
.chrome-layout-check*/

.chrome-hero-check/

.chrome-hero-color-check/

# Playwright CLI browser automation artifacts (session-specific: screenshots,
# videos, traces, request logs, page snapshots, console logs). Safe to keep
# locally for review; never committed. .playwright/cli.config.json is stable
# tooling config and is tracked separately, not covered by this rule.
.playwright-cli/
playwright-report/
test-results/
*.webm

# Claude Code local/personal settings - machine-specific permissions and
# absolute paths. The reusable playwright-cli skill under .claude/skills/ is
# tracked separately, not covered by this rule.
.claude/settings.local.json
